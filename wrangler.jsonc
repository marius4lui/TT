{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tt",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "apps/web/public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tt",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "EVOLUTION_URL": "https://evolution.example.invalid", "EVOLUTION_INSTANCE": "tt" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
}
