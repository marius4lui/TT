{
  "name": "tt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && node --test scripts/tests/*.test.mjs && wrangler deploy --dry-run --outdir dist",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "setup": "node scripts/setup.mjs",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ops": "node --test scripts/tests/*.test.mjs",
    "test:credentials": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/tests/credentials.test.ps1"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tt/core": "workspace:*",
    "@tt/whatsapp": "workspace:*",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.5",
    "jsonc-parser": "^3.3.1",
    "prettier": "3.8.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/marius4lui/TT.git"
  },
  "description": "Tischtennistraining über WhatsApp organisieren – auf dem eigenen Cloudflare-Account."
}
